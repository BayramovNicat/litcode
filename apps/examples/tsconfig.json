{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"],
      "@holmityd/litcode": ["../../packages/litcode/src/index.ts"],
      "@holmityd/litcode/core": ["../../packages/litcode/src/lib/core.ts"],
      "@holmityd/litcode/variants": ["../../packages/litcode/src/lib/variants.ts"],
      "@holmityd/litcode/components/*": ["../../packages/litcode/src/lib/components/*.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
