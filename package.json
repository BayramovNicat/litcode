{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/examples dev",
    "dev:examples": "bun run --cwd apps/examples dev",
    "build": "bun run --cwd packages/litcode build",
    "build:lib": "bun run --cwd packages/litcode build",
    "test": "bun run --cwd packages/litcode test",
    "test:lib": "bun run --cwd packages/litcode test",
    "test:browser": "bun run --cwd packages/litcode test:browser",
    "release": "bun run --cwd packages/litcode release",
    "release:minor": "bun run --cwd packages/litcode release:minor",
    "release:major": "bun run --cwd packages/litcode release:major"
  }
}
